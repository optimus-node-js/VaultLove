rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own data and query for partner codes
    match /users/{userId} {
      // Allow users to read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow querying for partner codes (needed to check code uniqueness)
      allow read: if request.auth != null;
    }
    
    // Partner connections - allow creation by authenticated users, 
    // read access to creator and partner
    match /partnerConnections/{connectionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId || 
         request.auth.uid == resource.data.partnerId);
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId || 
         request.auth.uid == resource.data.partnerId);
    }
    
    // Media collection - users can read/write their own media and their partner's media
    match /media/{mediaId} {
      // Allow reading media if user uploaded it or is partner
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.uploadedBy || 
         request.auth.uid == resource.data.partnerId);
      
      // Allow creating media if user is authenticated and setting themselves as uploader
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uploadedBy;
      
      // Allow updating media if user uploaded it
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.uploadedBy;
      
      // Allow deleting media if user uploaded it
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.uploadedBy;
    }
    
    // Albums collection - users can read/write their own albums and their partner's albums
    match /albums/{albumId} {
      // Allow reading albums if user created them or is partner
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.uid == resource.data.partnerId);
      
      // Allow creating albums if user is authenticated and setting themselves as creator
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.createdBy;
      
      // Allow updating albums if user created them
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      
      // Allow deleting albums if user created them
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
  }
} 